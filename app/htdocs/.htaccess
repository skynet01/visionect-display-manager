<IfModule mod_headers.c>
    <FilesMatch "^(index\.html|index\.php|status\.php)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
        Header always unset ETag
    </FilesMatch>
</IfModule>

# Module config.json files hold settings (and encrypted API keys) and *.bak* files may hold old
# source or secrets: never serve them over HTTP. PHP reads them from disk, which this does not affect.
<FilesMatch "^(config\.json|.*\.bak.*)$">
    Require all denied
</FilesMatch>
